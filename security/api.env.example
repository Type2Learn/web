# Local development only. This template is safe to commit; never replace these
# placeholders with real values. Production values belong in Render environment
# variables, never in Git or the browser.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# Gemini is attempted before OpenAI for normal learner chat and for the
# Behavioural Learning Partner. The partner uses Flash-Lite first and the
# server-side GPT-5.4 Nano role only to repair/verify its short JSON wording.
# Other adaptive and assessment paths retain their separately pinned roles.
# Use a comma-separated pool, or numbered variables such as
# GEMINI_CHAT_API_KEY_2, to rotate a new free-tier key into the pool.
GEMINI_CHAT_API_KEYS=replace-with-gemini-chat-key-1,replace-with-gemini-chat-key-2
# Reserved for rare heavy assessment/visual work. `gemtest` and the older
# requested `gemtext` aliases are accepted locally, but deployment should use
# the explicit names below.
GEMINI_TEST_API_KEYS=replace-with-gemini-heavy-key-1
SPEECHMATICS_API_KEY=replace-with-speechmatics-api-key
FIREBASE_PROJECT_ID=type2learn-defcc
FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-one-line-service-account-json
FIREBASE_STORAGE_BUCKET=replace-with-private-firebase-storage-bucket

# Private educator workspace. Generate the bootstrap digest locally, for
# example: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "your-one-time-code"
# Never add the plaintext code to this file or to Git.
EDUCATOR_WORKSPACE_ENABLED=false
ADMIN_BOOTSTRAP_CODE_SHA256=replace-with-sha256-of-one-time-admin-setup-code
ROLE_CODE_PEPPER=replace-with-a-long-random-server-only-secret

# Optional deployment controls. The approved model is hard-coded server-side.
AI_ALLOWED_ORIGINS=https://type2learn.tech,https://www.type2learn.tech,http://localhost:4173,http://127.0.0.1:4173
# Keep every generative feature opt-in and disabled until its consent, review,
# and storage controls are ready.
ADAPTIVE_LEARNING_ENABLED=false
BEHAVIOUR_CONTEXT_ENABLED=false
MASCOT_PARTNER_AI_ENABLED=false
# Consent summaries receive this expiry field. Configure Firestore TTL against
# `expiresAt`; the server also clears expired module summaries on later writes.
ADAPTIVE_RETENTION_DAYS=90
AI_ASSESSMENTS_ENABLED=false
AI_VISUALS_ENABLED=false

# The learner-facing authored reserve is available without a model. A reviewer
# Firebase UID and heavy Gemini/OpenAI fallback are required only to generate
# and publish a new AI candidate bank.
ASSESSMENT_REVIEWER_UIDS=

# Model roles are pinned in server/config.mjs: gpt-5.4-nano performs prompt
# checks and JSON verification; gpt-5.4-mini handles bounded adaptive/intent
# work; gpt-5.1 is reserved for reviewer-triggered final-bank generation.
