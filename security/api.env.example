# Local development only. This template is safe to commit; never replace these
# placeholders with real values. Production values belong in Render environment
# variables, never in Git or the browser.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
SPEECHMATICS_API_KEY=replace-with-speechmatics-api-key
FIREBASE_PROJECT_ID=type2learn-defcc
FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-one-line-service-account-json

# Optional deployment controls. The approved model is hard-coded server-side.
AI_ALLOWED_ORIGINS=https://type2learn.tech,https://www.type2learn.tech,http://localhost:4173,http://127.0.0.1:4173
